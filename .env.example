# Copier ce fichier en .env :  cp .env.example .env
# Identifiants de développement local uniquement.

# PostgreSQL
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=wikipedia_fr

# Corpus : Wikipédia FR sur Hugging Face (fichiers 0 à 16)
CORPUS_NAME=wikipedia_fr
CORPUS_URL_TEMPLATE=https://huggingface.co/datasets/wikimedia/wikipedia/resolve/main/20231101.fr/train-{shard:05d}-of-00017.parquet
MIN_DOC_CHARS=500

# Traitement
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP=150

# LLM : Ollama sur la machine hôte (API compatible OpenAI)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# Ray
RAY_DASHBOARD_URL=http://ray-head:8265
